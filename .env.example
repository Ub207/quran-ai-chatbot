# ── Required ────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Optional — model configuration ──────────────────────────────────────────
# Primary model (Groq free tier). All Meta Llama models on Groq are now
# Enterprise tier (paid only), so we default to the openai/gpt-oss-* family
# which is free on the Groq dev plan.
GROQ_MODEL_PRIMARY=openai/gpt-oss-20b

# Fallback model used if the primary is unavailable
GROQ_MODEL_FALLBACK=openai/gpt-oss-120b

# Embedding model for FAISS indexing
EMBED_MODEL=all-MiniLM-L6-v2

# ── Optional — logging ─────────────────────────────────────────────────────
# Set to DEBUG for verbose request/response logs; default INFO
LOG_LEVEL=INFO
